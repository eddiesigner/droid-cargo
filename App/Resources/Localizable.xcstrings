          }
        }
      }
    },
    "Unlock the phone and tap Allow on the “Allow USB debugging?” prompt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre das Telefon und tippe bei der Abfrage „USB-Debugging zulassen?“ auf „Zulassen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el teléfono y toca Permitir en el aviso “¿Permitir la depuración por USB?”."
          }
        }
      }
    },
    "Unlock the phone and tap Allow. Check “Always allow from this computer” to skip this next time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre das Telefon und tippe auf „Zulassen“. Aktiviere „Von diesem Computer immer zulassen“, um das künftig zu überspringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el teléfono y toca Permitir. Marca “Permitir siempre desde este ordenador” para no tener que hacerlo la próxima vez."
          }
        }
      }
    },
    "Unlock the phone, check that USB debugging is on, and set the USB mode to “File transfer / Android Auto”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
