          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el teléfono, comprueba que la depuración por USB esté activada y pon el modo USB en “Transferencia de archivos / Android Auto”."
          }
        }
      }
    },
